{
  "$defs": {
    "Document": {
      "additionalProperties": true,
      "properties": {
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "document_type": {
          "default": "unknown",
          "minLength": 1,
          "title": "Document Type",
          "type": "string"
        },
        "language": {
          "default": "und",
          "minLength": 1,
          "title": "Language",
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "title": "Sections",
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "title",
        "sections"
      ],
      "title": "Document",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "canonical_name": {
          "minLength": 1,
          "title": "Canonical Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "canonical_name"
      ],
      "title": "Entity",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": true,
      "properties": {
        "sentence_id": {
          "minLength": 1,
          "title": "Sentence Id",
          "type": "string"
        }
      },
      "required": [
        "sentence_id"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Paragraph": {
      "additionalProperties": true,
      "properties": {
        "paragraph_id": {
          "minLength": 1,
          "title": "Paragraph Id",
          "type": "string"
        },
        "sentences": {
          "items": {
            "$ref": "#/$defs/Sentence"
          },
          "title": "Sentences",
          "type": "array"
        }
      },
      "required": [
        "paragraph_id",
        "sentences"
      ],
      "title": "Paragraph",
      "type": "object"
    },
    "Proposition": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "evidence"
      ],
      "title": "Proposition",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "proposition_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Proposition Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "source",
        "target",
        "proposition_ids"
      ],
      "title": "Relation",
      "type": "object"
    },
    "Section": {
      "additionalProperties": true,
      "properties": {
        "section_id": {
          "minLength": 1,
          "title": "Section Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "paragraphs": {
          "items": {
            "$ref": "#/$defs/Paragraph"
          },
          "title": "Paragraphs",
          "type": "array"
        }
      },
      "required": [
        "section_id",
        "title",
        "paragraphs"
      ],
      "title": "Section",
      "type": "object"
    },
    "Sentence": {
      "additionalProperties": true,
      "properties": {
        "sentence_id": {
          "minLength": 1,
          "title": "Sentence Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "sentence_id",
        "text"
      ],
      "title": "Sentence",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "document": {
      "$ref": "#/$defs/Document"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/Entity"
      },
      "title": "Entities",
      "type": "array"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/Relation"
      },
      "title": "Relations",
      "type": "array"
    },
    "propositions": {
      "items": {
        "$ref": "#/$defs/Proposition"
      },
      "title": "Propositions",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "document"
  ],
  "title": "Input",
  "type": "object"
}