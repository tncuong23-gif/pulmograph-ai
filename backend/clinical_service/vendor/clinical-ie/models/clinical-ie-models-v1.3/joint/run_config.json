{
  "task": "joint_ner_relex_simple_sentence",
  "evaluation_target": "silver_simple_v1_3_oracle",
  "base_model": "knowledgator/gliner-relex-multi-v1.0",
  "relation_labels": [
    "has_result",
    "reveals",
    "located_at",
    "has_duration",
    "onset_at",
    "has_frequency",
    "occurs_at",
    "treated_with",
    "not_improved_by"
  ],
  "max_steps": 2500,
  "max_train_minutes": 95,
  "training_kwargs": {
    "max_steps": 2500,
    "learning_rate": 1e-05,
    "others_lr": 5e-05,
    "weight_decay": 0.01,
    "others_weight_decay": 0.01,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.1,
    "per_device_train_batch_size": 2,
    "per_device_eval_batch_size": 2,
    "gradient_accumulation_steps": 4,
    "max_grad_norm": 1.0,
    "focal_loss_alpha": 0.75,
    "focal_loss_gamma": 2.0,
    "rel_focal_loss_alpha": 0.75,
    "rel_focal_loss_gamma": 2.0,
    "negatives": 1.0,
    "masking": "none",
    "eval_strategy": "steps",
    "eval_steps": 300,
    "save_strategy": "steps",
    "save_steps": 300,
    "save_total_limit": 1,
    "logging_steps": 20,
    "fp16": false,
    "bf16": true,
    "dataloader_num_workers": 0,
    "report_to": "none",
    "seed": 42,
    "data_seed": 42
  }
}
