# Context/RAG/KG are embedded. Old *_BASE_URL variables for these modules are ignored.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8100
CLINICAL_IE_BASE_URL=http://127.0.0.1:8002
CLINICAL_IE_TIMEOUT_SECONDS=240
MODULE_TIMEOUT_SECONDS=180
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=180
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=20
TRACE_PIPELINE=false
DEBUG=false

# Original classifier artifact is bundled. sklearn training version: 1.6.1.
CLASSIFIER_PATH=models/E5_SVM_seed456.joblib
CLASSIFIER_EMBEDDING_MODEL=intfloat/multilingual-e5-base
CLASSIFIER_EMBEDDING_REVISION=d13f1b27baf31030b7fd040960d60d909913633f
CLASSIFIER_EMBEDDING_PREFIX="query: "
CLASSIFIER_NORMALIZE_EMBEDDINGS=true
CLASSIFIER_DEVICE=auto
DATABASE_PATH=data/assistant.sqlite3
UPLOAD_DIR=data/uploads

# Context graph: copy values from the OLD Context .env, adding CONTEXT_ prefix.
# Replace the URI/credentials with your existing Context Neo4j instance.
CONTEXT_GRAPH_BACKEND=neo4j
CONTEXT_NEO4J_URI=bolt://127.0.0.1:7688
CONTEXT_NEO4J_USER=neo4jkg_entity_names
CONTEXT_NEO4J_PASSWORD=change-me-please
CONTEXT_NEO4J_DATABASE=neo4j
CONTEXT_NLP_BACKEND=ollama
CONTEXT_OLLAMA_BASE_URL=http://127.0.0.1:11434
CONTEXT_OLLAMA_MODEL=qwen2.5:7b
CONTEXT_OLLAMA_TIMEOUT_SECONDS=120
CONTEXT_LLM_FALLBACK_TO_RULES=true
CONTEXT_EMBEDDING_BACKEND=hash
CONTEXT_TERMINOLOGY_MODE=off
CONTEXT_HISTORY_LIMIT=20
CONTEXT_RECENT_HISTORY_LIMIT=6

# RAG: existing Mongo database and Qdrant vectors; no automatic example import.
RAG_MODE=live
RAG_MONGO_URI=mongodb://127.0.0.1:27017
RAG_MONGO_DB=medical_rag
RAG_QDRANT_URL=http://127.0.0.1:6333
RAG_QDRANT_API_KEY=
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-base
RAG_EMBEDDING_REVISION=d13f1b27baf31030b7fd040960d60d909913633f
RAG_EMBEDDING_DEVICE=auto
RAG_CHUNK_TOKENS=450
# Overlap applies to legacy token mode only. Semantic mode preserves topic boundaries.
RAG_CHUNK_OVERLAP=80
RAG_CHUNK_METHOD=semantic
RAG_SEMANTIC_PERCENTILE=90
RAG_SEMANTIC_MIN_DISTANCE=0.05
RAG_SEMANTIC_MIN_TOKENS=80
RAG_SEMANTIC_WINDOW=2
# Used only if RAG_MODE=demo (lexical test search):
RAG_DEMO_DB=data/rag-demo.sqlite3

# KG: copy values from the OLD kg_module .env, adding KG_ where shown.
KG_NEO4J_URI=bolt://127.0.0.1:7687
KG_NEO4J_USERNAME=neo4j
KG_NEO4J_PASSWORD=change-me-please
KG_NEO4J_DATABASE=neo4j
KG_MONGODB_URI=mongodb://127.0.0.1:27017
KG_MONGODB_DATABASE=medical_kg
KG_ONTOLOGY_PATH=examples/kg/kg_ontology.example.json
KG_ENTITY_EMBEDDING_ENABLED=1
KG_QDRANT_URL=http://127.0.0.1:6333
KG_ENTITY_COLLECTION=kg_entity_names
KG_ENTITY_MODEL=Dqdung205/medical_vietnamese_embedding
KG_ENTITY_CANDIDATE_SCORE=0.9

# Voice: local STT; VieNeu runs in a separate .venv-vieneu service
VOICE_STT_MODEL='D:/medical_wed/banzip/medical-ai-integrated/backend/models/phowhisper-small-ct2'
VOICE_STT_DEVICE=cpu
VOICE_STT_COMPUTE=int8
VOICE_STT_BEAM_SIZE=3
VOICE_STT_CPU_THREADS=4
VOICE_STT_PRELOAD=true
VOICE_STT_VAD=true
VOICE_STT_VAD_THRESHOLD=0.35
VOICE_STT_VAD_SILENCE_MS=650
VOICE_STT_VAD_PAD_MS=300
# Optional override: short vocabulary hints, not facts about the speaker.
# VOICE_STT_INITIAL_PROMPT=
VOICE_TTS_PROVIDER=vieneu
# CPU: 1. GPU launcher supports 2 concurrent requests.
VOICE_TTS_CONCURRENCY=1
VOICE_TTS_VOICE=Mai Anh
# Local VieNeu v3 Turbo: PCM s16le, mono, 48 kHz
VOICE_TTS_BASE_URL=http://127.0.0.1:8880/v1
VOICE_TTS_MODEL=vieneu-v3-turbo
VOICE_TTS_API_KEY=
VITE_VOICE_PLAYBACK_MODE=smooth